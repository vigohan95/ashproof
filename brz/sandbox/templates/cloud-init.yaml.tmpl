#cloud-config
# Ashproof throwaway sandbox VM  -  task @@{task_id}
# Rendered by brz.sandbox.cloudinit; delivered to Vultr as POST /v2/instances user_data (base64).
# Boot sequence: packages -> write_files -> install gVisor -> LOCK DOWN EGRESS -> start TTL watchdog -> start runner.
hostname: @@{hostname}
manage_etc_hosts: true
timezone: UTC

users:
  - name: runner
    gecos: brz step runner (unprivileged)
    shell: /usr/sbin/nologin
    lock_passwd: true
    uid: 10001
    # deliberately: no sudo, no ssh keys, no password

package_update: true
package_upgrade: false
packages:
  - nftables
  - python3
  - ca-certificates
  - curl
  - conntrack

write_files:
  - path: /etc/brz/task.env
    permissions: "0644"
    content: |
      TASK_ID=@@{task_id}
      RUNNER_PORT=@@{runner_port}
      TTL_MINUTES=@@{ttl_minutes}
      DNS_SERVER=@@{dns_server}
      INNER_ISOLATION=@@{inner_isolation}
      ADMIN_CIDR=@@{admin_cidr}
  - path: /etc/brz/token.key
    permissions: "0600"
    owner: root:root
    content: "@@{token_key_hex}"
  - path: /etc/brz/allowed_domains.txt
    permissions: "0644"
    content: |
@@{allowed_domains_block}
  - path: /etc/brz/control_plane.cidr
    permissions: "0644"
    content: "@@{control_plane_cidr}"
  - path: /etc/systemd/resolved.conf.d/brz.conf
    permissions: "0644"
    content: |
      [Resolve]
      DNS=@@{dns_server}
      FallbackDNS=
      DNSStubListener=yes
      DNSOverTLS=no
  - path: /usr/local/bin/brz-install-gvisor
    permissions: "0755"
    content: |
      #!/bin/bash
      # Inner isolation layer: gVisor runsc, systrap platform (no KVM needed inside a VM).
      set -euo pipefail
      if [ "@@{inner_isolation}" != "gvisor" ]; then echo "gvisor disabled"; exit 0; fi
      # Release layout verified 2026-11-01: <release>/<arch>/gvisor.tar.bz2 (+ .sha512); there is NO bare
      # runsc file under release/latest any more.
      ARCH=$(uname -m)
      URL="@@{gvisor_release_url}/${ARCH}"
      WORK=$(mktemp -d)
      cd "$WORK"
      curl -fsSL --retry 3 -o gvisor.tar.bz2 "${URL}/gvisor.tar.bz2"
      curl -fsSL --retry 3 -o gvisor.tar.bz2.sha512 "${URL}/gvisor.tar.bz2.sha512"
      sha512sum -c gvisor.tar.bz2.sha512
      tar -xjf gvisor.tar.bz2
      test -f runsc && test -d gvisor-bin
      # release-20261026.0+ runs the sentry as sidecar binaries that MUST live in <dir of runsc>/gvisor-bin/
      # (verified in WSL 2026-11-01: without them `runsc run` fails with 'sidecar "gvisor_sentry" not usable').
      install -m 0755 runsc /usr/local/bin/runsc
      rm -rf /usr/local/bin/gvisor-bin
      cp -r gvisor-bin /usr/local/bin/gvisor-bin
      chmod -R 0755 /usr/local/bin/gvisor-bin
      cd / && rm -rf "$WORK"
      /usr/local/bin/runsc --version
  - path: /usr/local/bin/brz-egress-apply
    permissions: "0755"
    content: |
      #!/bin/bash
      # Default-deny egress with boot-time domain allowlist (see brz_runner/egress.py for the policy).
      set -euo pipefail
      export PYTHONPATH=/opt/brz/runner
      python3 -m brz_runner.egress
      nft list ruleset | head -n 60
  - path: /etc/systemd/system/brz-runner.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Ashproof step runner (task @@{task_id})
      After=network-online.target nftables.service
      Wants=network-online.target

      [Service]
      Type=simple
      EnvironmentFile=/etc/brz/task.env
      Environment=PYTHONPATH=/opt/brz/runner
      Environment=PYTHONUNBUFFERED=1
      WorkingDirectory=/work
      ExecStart=/usr/bin/python3 -m brz_runner --task-id @@{task_id} --token-key-file /etc/brz/token.key --workroot /work --port @@{runner_port} --allow-poweroff@@{runner_extra_args}
      Restart=on-failure
      RestartSec=2
      # The runner itself is root (it has to drive runsc); every STEP runs as uid 10001 inside gVisor.
      NoNewPrivileges=yes
      ProtectHome=read-only
      PrivateTmp=yes

      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/brz-ttl.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Ashproof TTL watchdog: power off the sandbox after @@{ttl_minutes} minutes

      [Service]
      Type=oneshot
      ExecStart=/bin/sh -c 'logger -t brz "TTL @@{ttl_minutes}m reached, powering off"; systemctl poweroff'
  - path: /etc/systemd/system/brz-ttl.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Ashproof TTL watchdog timer

      [Timer]
      OnBootSec=@@{ttl_minutes}min
      AccuracySec=10s
      Unit=brz-ttl.service

      [Install]
      WantedBy=timers.target
@@{runner_files_block}

runcmd:
  # The image ships linuxuser (uid 1000, groups sudo and lxd). Nothing here needs it.
  - [sh, -c, "userdel -r -f linuxuser 2>/dev/null || true"]
  - mkdir -p /work/input /work/out /work/steps /var/lib/brz/bundles
  - chown -R 10001:10001 /work
  - chmod 0600 /etc/brz/token.key
  - systemctl restart systemd-resolved
  - [bash, /usr/local/bin/brz-install-gvisor]
  - [bash, /usr/local/bin/brz-egress-apply]
  # After lock-down nothing on the host may talk out, so a BRZ-EGRESS line can only come from a step.
  - systemctl stop systemd-resolved systemd-timesyncd
  - sysctl -q -w net.ipv6.conf.all.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1
  - systemctl daemon-reload
  - systemctl enable --now brz-ttl.timer
  - systemctl enable --now brz-runner.service
  - sh -c 'sleep 2; curl -fsS http://127.0.0.1:@@{runner_port}/health || journalctl -u brz-runner --no-pager | tail -n 20'

final_message: "brz sandbox for task @@{task_id} ready after $UPTIME seconds (ttl @@{ttl_minutes}m, inner=@@{inner_isolation})"
