    "task_summary": "Total sales per region and write a short report",
    "steps": [
      {
        "id": "s1",
        "title": "totals",
        "kind": "python",
        "code": "\nimport csv, json, os\nrows = list(csv.DictReader(open(os.path.join(os.environ['BRZ_INPUT'], 'sales.csv'))))\ntot = {}\nfor r in rows:\n    tot[r['region']] = tot.get(r['region'], 0) + float(r['amount'])\njson.dump(dict(sorted(tot.items())), open(os.path.join(os.environ['BRZ_OUT'], 'summary.json'), 'w'), sort_keys=True)\nprint('totals written')\n",
        "expected_outputs": [
          "summary.json"
        ],
        "needs_network": false,
        "timeout_s": 120
      },
      {
        "id": "s2",
        "title": "report",
        "kind": "python",
        "code": "\nimport json, os\ntot = json.load(open(os.path.join(os.environ['BRZ_OUT'], 'summary.json')))\nopen(os.path.join(os.environ['BRZ_OUT'], 'report.md'), 'w').write(f\"north {tot['north']}, south {tot['south']}\")\nprint('report written')\n",
        "expected_outputs": [
          "report.md"
        ],
        "needs_network": false,
        "timeout_s": 120
      }
    ],
