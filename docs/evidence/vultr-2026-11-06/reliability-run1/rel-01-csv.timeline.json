    "code": "import csv, json, collections\n\ntotals = collections.defaultdict(float)\nwith open('/work/input/sales.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        totals[row['region'].strip()] += float(row['amount'])\n\nsummary = {region: round(totals[region], 2) for region in sorted(totals)}\nwith open('/work/out/summary.json', 'w') as f:\n    json.dump(summary, f, indent=2, sort_keys=True)\n    f.write('\\n')\n\nprint(json.dumps(summary, sort_keys=True))",
