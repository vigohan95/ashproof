    "title": "Attempt TCP connections and record results",
    "kind": "python",
    "code": "import json, socket\n\ntargets = [(\"1.1.1.1\", 443), (\"169.254.169.254\", 80)]\nresults = {}\nfor host, port in targets:\n    key = f\"{host}:{port}\"\n    try:\n        s = socket.create_connection((host, port), timeout=3)\n        s.close()\n        results[key] = {\"connected\": True, \"error\": None}\n    except Exception as e:\n        results[key] = {\"connected\": False, \"error\": f\"{type(e).__name__}: {e}\"}\n\nwith open(\"/work/out/walls.json\", \"w\") as f:\n    json.dump(results, f, indent=2, sort_keys=True)\nprint(json.dumps(results, indent=2, sort_keys=True))",
    "expected_outputs": [
     "walls.json"
    ],
    "needs_network": true,
    "timeout_s": 20
   }
  ],
