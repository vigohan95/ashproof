    "title": "Aggregate amounts per region",
    "kind": "python",
    "code": "import csv, json, collections\n\ntotals = collections.OrderedDict()\nwith open('/work/input/sales.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        region = row['region'].strip()\n        totals[region] = totals.get(region, 0.0) + float(row['amount'])\n\n# sort by region for deterministic output\nresult = {\"regions\": {k: round(v, 2) for k, v in sorted(totals.items())}}\nwith open('/work/out/summary.json', 'w') as f:\n    json.dump(result, f, indent=2, sort_keys=True)\n    f.write('\\n')\nprint(json.dumps(result))",
    "expected_outputs": [
     "summary.json"
    ],
    "needs_network": false,
    "timeout_s": 60
   }
  ],
