  "refused_reason": "",
  "steps": [
   {
    "id": "1",
    "title": "Attempt TCP connections and record results",
    "kind": "python",
    "code": "import json, socket\n\ntargets = [(\"1.1.1.1\", 443), (\"169.254.169.254\", 80)]\nresults = {}\nfor host, port in targets:\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.settimeout(3.0)\n    try:\n        s.connect((host, port))\n        results[\"%s:%d\" % (host, port)] = {\"connected\": True, \"error\": None}\n    except Exception as e:\n        results[\"%s:%d\" % (host, port)] = {\"connected\": False, \"error\": \"%s: %s\" % (type(e).__name__, e)}\n    finally:\n        s.close()\n\nwith open(\"/work/out/walls.json\", \"w\") as f:\n    json.dump(results, f, indent=2, sort_keys=True)\nprint(json.dumps(results, indent=2, sort_keys=True))",
    "expected_outputs": [
     "walls.json"
    ],
    "needs_network": true,
    "timeout_s": 30
   }
  ],
  "required_domains": [],
  "assertions": [
   "file_exists:walls.json",
