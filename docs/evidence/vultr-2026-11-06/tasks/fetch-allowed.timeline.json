    "id": "fetch_and_extract",
    "title": "Fetch example.com and extract h1 text",
    "kind": "python",
    "code": "import urllib.request, re\nfrom html.parser import HTMLParser\n\nhtml = urllib.request.urlopen('https://example.com', timeout=30).read().decode('utf-8', 'replace')\n\nclass H1(HTMLParser):\n    def __init__(self):\n        super().__init__()\n        self.in_h1 = False\n        self.depth = 0\n        self.parts = []\n    def handle_starttag(self, tag, attrs):\n        if tag == 'h1':\n            self.depth += 1\n            self.in_h1 = True\n    def handle_endtag(self, tag):\n        if tag == 'h1' and self.depth:\n            self.depth -= 1\n            if self.depth == 0:\n                self.in_h1 = False\n    def handle_data(self, data):\n        if self.in_h1:\n            self.parts.append(data)\n\np = H1()\np.feed(html)\ntext = ' '.join(''.join(p.parts).split())\nif not text:\n    # fallback regex, tolerant of whitespace/newlines inside tags\n    m = re.search(r'<h1\\b[^>]*>(.*?)</h1>', html, re.S | re.I)\n    if not m:\n        raise SystemExit('no h1 found; page head: ' + html[:200])\n    text = re.sub(r'<[^>]+>', ' ', m.group(1))\n    text = ' '.join(text.split())\n\nopen('/work/out/title.txt', 'w').write(text + '\\n')\nprint(text)",
    "expected_outputs": [
     "title.txt"
    ],
    "needs_network": true,
    "timeout_s": 60
   }
  ],
