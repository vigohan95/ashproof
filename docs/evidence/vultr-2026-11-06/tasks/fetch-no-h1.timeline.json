    "kind": "python",
    "code": "import urllib.request, re, sys\nurl = 'https://example.com'\nreq = urllib.request.Request(url, headers={'User-Agent': 'Ashproof/1.0'})\ntry:\n    html = urllib.request.urlopen(req, timeout=30).read().decode('utf-8', 'replace')\nexcept Exception as e:\n    raise SystemExit('fetch failed: %r' % e)\nprint('fetched %d bytes' % len(html), file=sys.stderr)\nm = re.search(r'<h1[^>]*>(.*?)</h1>', html, re.S | re.I)\nif not m:\n    raise SystemExit('no h1 found; body head: %r' % html[:500])\ntext = re.sub(r'<[^>]+>', '', m.group(1))\ntext = re.sub(r'\\s+', ' ', text).strip()\nwith open('/work/out/title.txt', 'w') as f:\n    f.write(text + '\\n')\nprint(text)",
