    "title": "Aggregate amounts per region",
    "kind": "python",
    "code": "import csv, json, collections\n\ntotals = collections.OrderedDict()\nwith open('/work/input/sales.csv', newline='') as f:\n    for row in csv.DictReader(f):\n        region = row['region'].strip()\n        totals[region] = totals.get(region, 0.0) + float(row['amount'])\n\n# sort by region name for deterministic output\ntotals = collections.OrderedDict(sorted(totals.items(), key=lambda kv: kv[0]))\nwith open('/work/out/summary.json', 'w') as f:\n    json.dump(totals, f, indent=2)\n    f.write('\\n')\nprint('regions:', len(totals))\n",
    "expected_outputs": [
     "summary.json"
    ],
    "needs_network": false,
    "timeout_s": 60
   }
