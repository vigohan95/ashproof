    "id": "step-1",
    "title": "Aggregate amounts per region and write summary.json",
    "kind": "python",
    "code": "import csv, json, collections\n\nwith open('/work/input/sales.csv', newline='') as f:\n    rows = list(csv.DictReader(f))\n\nif not rows:\n    raise SystemExit('sales.csv is empty or missing header')\n\nif 'region' not in rows[0] or 'amount' not in rows[0]:\n    raise SystemExit('sales.csv must contain region and amount columns')\n\ntotals = collections.OrderedDict()\nfor r in rows:\n    region = (r['region'] or '').strip()\n    totals[region] = totals.get(region, 0.0) + float(r['amount'] or 0)\n\nsummary = {\"regions\": {k: round(v, 2) for k, v in sorted(totals.items())},\n           \"grand_total\": round(sum(totals.values()), 2)}\n\nwith open('/work/out/summary.json', 'w') as f:\n    json.dump(summary, f, indent=2, sort_keys=True)\n    f.write('\\n')\n\nprint(json.dumps(summary, sort_keys=True))",
    "expected_outputs": [
     "summary.json"
    ],
    "needs_network": false,
    "timeout_s": 60
   }
  ],
  "required_domains": [],
